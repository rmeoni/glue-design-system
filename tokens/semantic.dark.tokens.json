{
  "$description": "Glue Design System — semantic tokens, dark theme. Same keys as the light theme.",
  "color": {
    "$type": "color",
    "bg": {
      "page":        { "$value": "{color.neutral.900}" },
      "surface":     { "$value": "{color.neutral.800}" },
      "surface-alt": { "$value": "{color.neutral.800}" },
      "raised":      { "$value": "{color.neutral.800}" },
      "inverse":     { "$value": "{color.navy.200}" }
    },
    "skeleton": {
      "$description": "Loading placeholders. Decorative: no contrast requirement, but the base must read against bg.page and bg.raised.",
      "base":      { "$value": "{color.neutral.700}" },
      "highlight": { "$value": "{color.neutral.600}", "$description": "Shimmer that sweeps across the base." }
    },
    "footer": {
      "$description": "Footer surface, as on uxrodrigo.com: navy in light, near-black in dark, light text.",
      "bg":          { "$value": "{color.neutral.900}" },
      "bottom-bg":   { "$value": "{color.black}", "$description": "Bottom bar (copyright, legal links)." },
      "border":      { "$value": "{color.neutral.700}" },
      "text":        { "$value": "{color.navy.100}", "$description": "Footer links. 16.1:1 on footer.bg." },
      "text-muted":  { "$value": "{color.neutral.400}", "$description": "Bottom bar text, dividers, pressed links. 5.58:1 on footer.bg." },
      "disabled":    { "$value": "{color.neutral.500}" },
      "focus":       { "$value": "{color.coral.400}", "$description": "Focus ring on the footer. 6.78:1 on footer.bg." }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.100}" },
      "secondary": { "$value": "{color.neutral.400}" },
      "accent":    { "$value": "{color.coral.400}" },
      "link":      { "$value": "{color.coral.400}" },
      "on-inverse":{ "$value": "{color.navy.900}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.700}" },
      "control": { "$value": "{color.neutral.500}", "$description": "3.73:1 on neutral-900." },
      "strong":  { "$value": "{color.neutral.100}" }
    },
    "icon": {
      "spot": { "$value": "{color.neutral.100}", "$description": "Hand-made spot icons." }
    },
    "focus-ring": { "$value": "{color.coral.400}" },
    "action": {
      "primary-bg":          { "$value": "{color.navy.200}" },
      "primary-bg-hover":    { "$value": "{color.navy.100}" },
      "primary-fg":          { "$value": "{color.navy.900}" },
      "secondary-border":    { "$value": "{color.neutral.100}" },
      "secondary-fg":        { "$value": "{color.neutral.100}" },
      "secondary-bg-hover":  { "$value": "{color.neutral.700}" },
      "chip-bg":             { "$value": "{color.neutral.700}" },
      "chip-bg-hover":       { "$value": "{color.neutral.600}" },
      "chip-fg":             { "$value": "{color.neutral.100}" },
      "chip-bg-selected":    { "$value": "{color.coral.400}" },
      "chip-fg-selected":    { "$value": "{color.neutral.900}" },
      "on-inverse":          { "$value": "{color.navy.700}", "$description": "Text actions on bg.inverse (snackbar action). 7.67:1 on navy.200." },
      "disabled-bg":         { "$value": "{color.neutral.800}" },
      "disabled-fg":         { "$value": "{color.neutral.500}" }
    },
    "feedback": {
      "success-fg": { "$value": "{color.green.300}" },
      "success-bg": { "$value": "{color.green.900}" },
      "warning-fg": { "$value": "{color.amber.300}" },
      "warning-bg": { "$value": "{color.amber.900}" },
      "error-fg":   { "$value": "{color.red.300}" },
      "error-bg":   { "$value": "{color.red.900}" },
      "info-fg":    { "$value": "{color.navy.200}" },
      "info-bg":    { "$value": "{color.navy.900}" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "card":  { "$value": "{shadow.sm}" },
    "raised":{ "$value": "{shadow.lg}" }
  }
}
